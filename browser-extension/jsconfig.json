{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["**/*.js"],
  "exclude": ["../node_modules", "../dist"]
}
