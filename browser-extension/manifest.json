{
  "manifest_version": 3,
  "name": "Browser Automation Bridge",
  "version": "0.2.0",
  "description": "Connect multiple AI agents concurrently to your browser tabs.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "webNavigation",
    "webRequest",
    "storage",
    "alarms",
    "clipboardRead"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Browser Automation Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": { "page": "status.html", "open_in_tab": true },
  "key": ""
}
