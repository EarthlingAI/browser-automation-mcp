{
	"name": "browser-automation-mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Browser automation MCP — agents drive the user's Chrome via an MV3 extension; runs in the background, never stealing focus by default.",
	"license": "MIT",
	"type": "commonjs",
	"main": "dist/index.js",
	"bin": {
		"browser-automation-mcp": "dist/index.js"
	},
	"scripts": {
		"build": "node scripts/build.js",
		"dev": "node scripts/build.js --watch",
		"start": "node dist/index.js",
		"daemon": "node dist/index.js --daemon",
		"test": "node --test --test-reporter=spec scripts/tests/*.test.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"ws": "^8.20.0",
		"zod": "^3.23.8",
		"zod-to-json-schema": "^3.23.5"
	},
	"devDependencies": {
		"@types/chrome": "^0.1.42",
		"@types/node": "^22.0.0",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.28.0",
		"typescript": "^5.6.0"
	}
}
